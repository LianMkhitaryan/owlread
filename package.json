{
  "name": "owlread",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @owlread/extension dev",
    "dev:firefox": "pnpm --filter @owlread/extension dev:firefox",
